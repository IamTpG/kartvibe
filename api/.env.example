# Môi trường chạy. `npm run reset` từ chối chạy khi là `production` hoặc khi DB không ở máy local.
NODE_ENV=development

# Postgres (tạo DB trước: createdb kartvibe, hoặc dùng docker — xem README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/kartvibe?schema=public"
PORT=3000
LOG_LEVEL=info
