# Sao chép thành .env để đổi cấu hình (không commit .env). Biến đã đặt trong môi trường/shell được ưu tiên hơn file này.
PORT=4002

# Postgres: dùng chung server, mỗi service một database riêng. Không đặt DATABASE_URL chung cho nhiều service.
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=kartvibe_order

# Độ trễ giả mỗi request nghiệp vụ (ms); 0 là tắt. start-all.sh đặt 30 cho demo và đo.
LATENCY_MS=0
