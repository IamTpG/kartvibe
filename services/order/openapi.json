{
  "openapi": "3.1.0",
  "info": {
    "title": "Order Service",
    "version": "1.0.0",
    "description": "Đơn hàng theo người dùng. Mỗi service sở hữu hợp đồng của mình."
  },
  "servers": [
    {
      "url": "http://localhost:4002"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "description": "Lỗi chung của mọi service; không lộ stack trace."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "dbQueries": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "service",
          "requests",
          "dbQueries"
        ],
        "additionalProperties": false,
        "description": "Bộ đếm phục vụ đo; không tính /health và /_metrics."
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "productId",
          "quantity"
        ],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "userId": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PAID",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        },
        "required": [
          "id",
          "userId",
          "status",
          "createdAt",
          "items"
        ],
        "additionalProperties": false,
        "description": "items theo thứ tự item_index."
      },
      "OrderList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PurchaseOrderRequest": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": false
      },
      "PurchaseOrderResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "minimum": 1
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED"
            ]
          }
        },
        "required": [
          "orderId",
          "sku",
          "quantity",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "Đơn của một người dùng, sắp theo id tăng dần",
        "description": "Mỗi lời gọi dùng đúng 2 truy vấn DB (lấy đơn, rồi lấy mọi item của các đơn đó).",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "required": true,
            "name": "userId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách đơn (rỗng nếu không có)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderList"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: userId sai kiểu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Giữ hàng và tạo đơn mua mới",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đơn đã xác nhận",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "OUT_OF_STOCK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "INVENTORY_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "INVENTORY_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Còn sống",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/_metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Bộ đếm",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              }
            }
          }
        }
      }
    },
    "/_metrics/reset": {
      "post": {
        "responses": {
          "204": {
            "description": "Đã đặt lại bộ đếm"
          }
        }
      }
    },
    "/_reset": {
      "post": {
        "description": "Chỉ bật khi ENABLE_TEST_HOOKS=1",
        "responses": {
          "204": {
            "description": "Đã xóa purchase_orders và đặt lại id"
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
