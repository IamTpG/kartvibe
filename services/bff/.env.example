# Sao chép thành .env để đổi cấu hình (không commit .env). Biến đã đặt trong môi trường/shell được ưu tiên hơn file này.
PORT=4004

# Địa chỉ các service nguồn
USER_SERVICE_URL=http://localhost:4001
ORDER_SERVICE_URL=http://localhost:4002
PRODUCT_SERVICE_URL=http://localhost:4003

# Product quá hạn thì trả một phần (ms); User/Order quá hạn thì lỗi toàn bộ
PRODUCT_TIMEOUT_MS=1000
UPSTREAM_TIMEOUT_MS=5000
