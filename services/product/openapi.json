{
  "openapi": "3.1.0",
  "info": {
    "title": "Product Service",
    "version": "1.0.0",
    "description": "Danh mục product. Các điểm vào /_fault và /_seed chỉ có khi ENABLE_TEST_HOOKS=1 nên không nằm trong hợp đồng."
  },
  "servers": [
    {
      "url": "http://localhost:4003"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "description": "Lỗi chung của mọi service; không lộ stack trace."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "dbQueries": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "service",
          "requests",
          "dbQueries"
        ],
        "additionalProperties": false,
        "description": "Bộ đếm phục vụ đo; không tính /health và /_metrics."
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": 0
          },
          "thumbnail": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "price",
          "thumbnail",
          "description"
        ],
        "additionalProperties": false
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/products/{id}": {
      "get": {
        "summary": "Lấy một product (1 request, 1 truy vấn DB)",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "PRODUCT_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Lấy nhiều product theo ids (1 request, 1 truy vấn DB)",
        "description": "ids là số nguyên cách nhau dấu phẩy. Id trùng chỉ tính một; id không tồn tại bị bỏ qua; kết quả sắp theo id tăng dần; tối đa 200 id.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "8,9,10"
            },
            "required": true,
            "name": "ids",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Các product tìm thấy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: sai định dạng hoặc quá 200 id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Còn sống",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/_metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Bộ đếm",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              }
            }
          }
        }
      }
    },
    "/_metrics/reset": {
      "post": {
        "responses": {
          "204": {
            "description": "Đã đặt lại bộ đếm"
          }
        }
      }
    }
  },
  "webhooks": {}
}
