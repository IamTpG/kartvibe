{
  "openapi": "3.1.0",
  "info": {
    "title": "User Service",
    "version": "1.0.0",
    "description": "Dữ liệu người dùng. Mỗi service sở hữu hợp đồng của mình."
  },
  "servers": [
    {
      "url": "http://localhost:4001"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "description": "Lỗi chung của mọi service; không lộ stack trace."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "Metrics": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "dbQueries": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "service",
          "requests",
          "dbQueries"
        ],
        "additionalProperties": false,
        "description": "Bộ đếm phục vụ đo; không tính /health và /_metrics."
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/users/{id}": {
      "get": {
        "summary": "Lấy một người dùng",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Người dùng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "USER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Còn sống",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/_metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Bộ đếm",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              }
            }
          }
        }
      }
    },
    "/_metrics/reset": {
      "post": {
        "responses": {
          "204": {
            "description": "Đã đặt lại bộ đếm"
          }
        }
      }
    }
  },
  "webhooks": {}
}
