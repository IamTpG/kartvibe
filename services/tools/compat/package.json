    "build": "tsc --noEmit",
    "fakes": "node test/run-fakes.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.6",
    "cors": "2.8.6",
    "express": "5.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "grpc-tools": "1.13.1",
    "ts-proto": "2.13.0",
    "typescript": "7.0.2"
  }
}
