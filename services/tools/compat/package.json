{
  "name": "kartvibe-tools-compat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "compat.mjs: kiểm client cũ/mới × server cũ/mới qua POST /orders và log (W3). Bản giả trong test/ chỉ để chạy npm run check.",
  "scripts": {
    "check": "node test/check.mjs",
    "evidence": "node test/check.mjs --evidence-dir evidence/compat-ban-gia",
